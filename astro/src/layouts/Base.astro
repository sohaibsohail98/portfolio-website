---
import '../styles/global.css';
import Icon from '../components/Icon.astro';
import { nav, socials } from '../data/site.js';
const { title, description } = Astro.props;
const og = 'https://sohaibsohail.pages.dev/og.png';
---
<!DOCTYPE html>
<html lang="en" data-theme="paper" class="">
<head>
  <script is:inline>document.documentElement.classList.add('js')</script>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href="https://sohaibsohail.pages.dev/" />
  <meta property="og:type" content="website" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content="https://sohaibsohail.pages.dev/" />
  <meta property="og:image" content={og} />
  <meta name="twitter:card" content="summary_large_image" />
  <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='7' fill='%233A2FE0'/%3E%3Ctext x='16' y='22' font-family='Georgia,serif' font-size='17' font-weight='700' fill='%23fff' text-anchor='middle'%3ES%3C/text%3E%3C/svg%3E" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Schibsted+Grotesk:wght@400;500;600;700&family=Instrument+Serif:ital@0;1&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet" />
  <script type="application/ld+json" set:html={JSON.stringify({
    '@context':'https://schema.org','@type':'Person','name':'Sohaib Sohail',
    jobTitle:'Cloud & AI Platform Engineer',
    address:{'@type':'PostalAddress',addressLocality:'Preston',addressCountry:'GB'},
    email:'sscontactenquiries@gmail.com',
    sameAs:['https://github.com/sohaibsohail98','https://linkedin.com/in/sohaibsohail','https://medium.com/@sohaibsohailengineer']
  })} />
</head>
<body class="font-sans text-[16.5px] leading-[1.62] antialiased">
  <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:left-3 focus:top-3 focus:z-50 focus:bg-ink focus:px-4 focus:py-2 focus:text-paper">Skip to content</a>

  <!-- top bar -->
  <header class="sticky top-0 z-40 backdrop-blur-md" style="background:color-mix(in srgb,var(--paper) 86%,transparent)">
    <div class="mx-auto flex max-w-content items-center gap-4 px-6 py-3">
      <a href="#main" class="text-[15px] font-semibold tracking-[-.015em]">Sohaib Sohail</a>
      <nav id="topnav" aria-label="Sections" class="ml-auto hidden items-center gap-1 md:flex">
        {nav.map(n => <a href={n.href} class="rounded-md px-2.5 py-1.5 text-[13px] text-mid transition hover:bg-[var(--accw)] hover:text-ink">{n.label}</a>)}
      </nav>
      <div class="ml-auto flex items-center gap-2 md:ml-3">
        <button id="tt" aria-label="Toggle colour theme"
          class="grid h-[30px] w-[30px] place-items-center rounded-full border border-hair2 text-[11px] text-mid transition hover:border-ink hover:text-ink">◐</button>
        <button id="burger" aria-label="Menu" aria-expanded="false" aria-controls="sidebar"
          class="grid h-[30px] w-[30px] place-items-center rounded-lg border border-hair2 text-mid transition hover:border-ink hover:text-ink md:hidden">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
        </button>
      </div>
    </div>
  </header>

  <!-- right sidebar: mobile only (below md). Desktop gets the inline #topnav above. -->
  <nav id="sidebar" aria-label="Primary" class="sidebar">
    <div class="flex flex-col gap-1 p-6 pt-8">
      <span class="mb-3 font-mono text-[10px] uppercase tracking-[.16em] text-low">Navigate</span>
      {nav.map(n => <a href={n.href} class="rounded-md px-2 py-2 text-[15px] text-mid transition hover:bg-[var(--accw)] hover:text-ink">{n.label}</a>)}
      <span class="mb-2 mt-5 font-mono text-[10px] uppercase tracking-[.16em] text-low">Elsewhere</span>
      <div class="flex flex-wrap gap-2">
        {socials.map(s => <a href={s.href} target="_blank" rel="noopener" title={s.label} aria-label={s.label}
          class="grid h-9 w-9 place-items-center rounded-lg border border-hair text-mid transition hover:border-acc hover:text-acc"><Icon name={s.icon} /></a>)}
      </div>
      <a href="/Sohaib-Sohail-CV.pdf" class="mt-5 rounded-full border border-acc px-4 py-2 text-center text-[13px] text-acc transition hover:bg-[var(--accw)]">Download CV</a>
    </div>
  </nav>
  <div id="scrim" class="scrim"></div>

  <main id="main"><slot /></main>

  <style>
    .sidebar{position:fixed;top:0;right:0;bottom:0;width:280px;max-width:82vw;z-index:60;
      background:var(--surf);border-left:1px solid var(--hair);transform:translateX(100%);
      transition:transform .3s cubic-bezier(.2,.8,.2,1);overflow-y:auto;box-shadow:-20px 0 60px -30px rgba(0,0,0,.4)}
    .sidebar.open{transform:translateX(0)}
    .scrim{position:fixed;inset:0;z-index:50;background:rgba(0,0,0,.3);opacity:0;pointer-events:none;transition:opacity .3s}
    .sidebar.open ~ .scrim{opacity:1;pointer-events:auto}
  </style>
  <script>
    import '../scripts/client.js';
    document.getElementById('scrim')?.addEventListener('click', () => {
      document.getElementById('sidebar')?.classList.remove('open');
      document.getElementById('burger')?.setAttribute('aria-expanded','false');
    });
  </script>
</body>
</html>
