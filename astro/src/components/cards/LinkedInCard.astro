---
// One live LinkedIn post embed in the rail. The permalink fallback link
// below always shows, whether or not the embed itself renders: LinkedIn's
// iframe frequently comes back blank for visitors who aren't logged into
// LinkedIn or have third-party cookies blocked, which is common on mobile
// browsers and is not something fixable from this codebase. A dead embed
// should degrade to a working link, not a blank box.
import { swatch } from '../../data/palette.js';
const { post, index } = Astro.props;
const accent = swatch(index);
// Numeric id is shared between the urn:li:share/urn:li:ugcPost embed
// format and the urn:li:activity permalink format, so this builds a
// working "open on LinkedIn" link straight from the same id we already have.
const activityId = post.urn.split(':').pop();
const permalink = `https://www.linkedin.com/feed/update/urn:li:activity:${activityId}/`;
---
<div class:list={["rail-item-xl acc-top", `acc-top-${accent}`, "rail-card rail-card-h-xl overflow-hidden rounded-xl border border-hair bg-surf"]}>
  <div class="rail-card-body">
    <iframe
      src={`https://www.linkedin.com/embed/feed/update/${post.urn}`}
      height={post.h}
      width="100%"
      frameborder="0"
      title="LinkedIn post"
    ></iframe>
  </div>
  <a href={permalink} target="_blank" rel="noopener"
    class:list={["flex items-center justify-center gap-1.5 border-t border-hair py-2.5 font-mono text-[11px] transition hover:bg-[var(--accw)]", `acc-text-${accent}`]}>
    View on LinkedIn ↗
  </a>
</div>
