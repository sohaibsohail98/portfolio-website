---
// Front face of a case study: meta, title, one-line summary. Tapping it
// opens the matching <dialog id={`case-${index}`}> (see CaseDialog.astro)
// with the full Problem / What I did / Result breakdown.
import { swatch } from '../../data/palette.js';
const { c, index } = Astro.props;
const accent = swatch(index);
---
<button type="button" data-open-dialog={`case-${index}`}
  class:list={["rail-item-xl acc-top", `acc-top-${accent}`, "rail-card rail-card-h-sm rounded-xl border border-hair bg-surf p-5 text-left transition hover:-translate-y-1 hover:border-acc"]}>
  <span class:list={["font-mono text-[11px]", `acc-text-${accent}`]}>{c.m}</span>
  <b class="mt-1.5 block text-[17px] font-semibold leading-[1.3] tracking-[-.025em]">{c.t}</b>
  <div class="rail-card-body mt-2 pr-1">
    <p class="m-0 text-[14px] leading-[1.55] text-mid">{c.sum}</p>
  </div>
  <span class="mt-3 flex items-center gap-1.5 font-mono text-[11.5px] text-acc">Read the write-up →</span>
</button>
