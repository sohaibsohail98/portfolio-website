---
import Section from '../Section.astro';
import CardRail from '../CardRail.astro';
import RecommendationCard from '../cards/RecommendationCard.astro';
import { recommendations, testimonial } from '../../data/content.js';

// The one anonymous testimonial shares a card shape with the named
// LinkedIn recommendations, just without a name/title and with a bolded
// figure in the quote, so it slots into the same rail.
const all = [
  { context: testimonial.who, quote: testimonial.quote, bold: '45%' },
  ...recommendations,
];
---
<Section id="recommendations" num="05" title="Recommendations"
  intro="From people who managed me or shipped alongside me.">
  <CardRail id="rail-recommendations" ariaLabel="Recommendations">
    {all.map((rec, i) => <RecommendationCard rec={rec} index={i} />)}
  </CardRail>
</Section>
