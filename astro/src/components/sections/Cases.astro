---
import Section from '../Section.astro';
import CardRail from '../CardRail.astro';
import CaseCard from '../cards/CaseCard.astro';
import CaseDialog from '../cards/CaseDialog.astro';
import { cases } from '../../data/content.js';
---
<Section id="cases" num="03" title="Case studies"
  intro="Platform work is mostly invisible, so here it is written up the way I would write a postmortem. Tap a card for the full breakdown.">
  <CardRail id="rail-cases" ariaLabel="Case studies">
    {cases.map((c, i) => <CaseCard c={c} index={i} />)}
  </CardRail>
  {cases.map((c, i) => <CaseDialog c={c} index={i} />)}
</Section>
