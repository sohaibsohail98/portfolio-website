---
import { stats } from '../../data/site.js';
import { intro } from '../../data/content.js';
---
<header class="px-6 pt-14 pb-12 md:pt-16">
  <div class="mx-auto max-w-content">
    <div class="mb-6 inline-flex flex-wrap items-center gap-2 font-mono text-[11px] uppercase tracking-[.09em] text-[var(--live)] sm:text-[11.5px]">
      <span class="h-[7px] w-[7px] rounded-full bg-[var(--live)]"></span>Open to work · senior, staff or principal · UK remote or hybrid
    </div>
    <h1 class="m-0 max-w-[20ch] text-[clamp(32px,5.4vw,60px)] font-bold leading-[1.04] tracking-[-.04em]">
      I take <span class="font-serif italic text-acc">AI agents</span> from prototype to production, and build the platform they run on.
    </h1>
    <p class="mt-6 max-w-[60ch] text-[16px] leading-[1.62] text-mid sm:text-[17px]">{intro}</p>
    <div class="hero-ctas mt-7 flex flex-wrap gap-3">
      <a href="https://sre-agent.sohaibsohail.workers.dev" target="_blank" rel="noopener" data-cta="primary" class="w-full rounded-full border border-ink bg-ink px-5 py-3 text-center text-[14.5px] text-paper transition hover:opacity-85 sm:w-auto sm:py-2.5">Try the live agent</a>
      <a href="https://calendly.com/techwithsohaib/chat-with-sohaib" target="_blank" rel="noopener" class="flex-1 rounded-full border border-hair2 px-5 py-3 text-center text-[14.5px] text-mid transition hover:border-ink hover:text-ink sm:flex-none sm:py-2.5">Book a chat</a>
      <a href="/Sohaib-Sohail-CV.pdf" class="flex-1 rounded-full border border-hair2 px-5 py-3 text-center text-[14.5px] text-mid transition hover:border-ink hover:text-ink sm:flex-none sm:py-2.5">Download CV</a>
    </div>
    <dl class="mt-10 grid grid-cols-3 gap-x-4 border-t border-hair sm:gap-x-8">
      {stats.map(s => (
        <div class="py-4 sm:py-5">
          <dd class="m-0 text-[22px] font-semibold leading-none tracking-[-.035em] [font-variant-numeric:tabular-nums] sm:text-[27px]">{s.v}</dd>
          <dt class="mt-1.5 text-[11.5px] leading-[1.4] text-low sm:mt-2 sm:max-w-[22ch] sm:text-[12.5px]">{s.k}</dt>
        </div>
      ))}
    </dl>
  </div>
</header>
