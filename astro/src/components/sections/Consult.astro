---
import Section from '../Section.astro';
import { consult } from '../../data/content.js';
---
<Section id="consult" num="05" title="Work with me"
  intro="I take a limited number of 1:1 sessions outside of work, for people who want a steer from someone a few steps further down the same road.">
  <div class="grid grid-cols-1 gap-4 sm:grid-cols-3">
    {consult.services.map(([t, d]) => (
      <div class="rounded-xl border border-hair bg-surf p-5">
        <h3 class="m-0 text-[15px] font-semibold">{t}</h3>
        <p class="mt-2 text-[13.5px] leading-[1.55] text-mid">{d}</p>
      </div>
    ))}
  </div>
  <a href="https://calendly.com/techwithsohaib/chat-with-sohaib" target="_blank" rel="noopener"
    class="mt-6 inline-block rounded-full border border-ink bg-ink px-5 py-2.5 text-[14.5px] text-paper transition hover:opacity-85">Book a session →</a>
</Section>
