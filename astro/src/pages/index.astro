---
// The whole page is an assembly of section components. Each section owns its
// own markup; content lives in src/data. To change copy, edit the data file.
import Base from '../layouts/Base.astro';
import Hero from '../components/sections/Hero.astro';
import Console from '../components/sections/Console.astro';
import Work from '../components/sections/Work.astro';
import Cases from '../components/sections/Cases.astro';
import Experience from '../components/sections/Experience.astro';
import Recommendations from '../components/sections/Recommendations.astro';
import Consult from '../components/sections/Consult.astro';
import Writing from '../components/sections/Writing.astro';
import Background from '../components/sections/Background.astro';
import Footer from '../components/sections/Footer.astro';

const title = 'Sohaib Sohail · Cloud & AI Platform Engineer, UK';
const description = 'I take AI agents from prototype to production, and build the platform they run on. Bedrock agents, MCP servers, LLM evaluation, Terraform across three clouds. Available for senior roles.';
---
<Base title={title} description={description}>
  <Hero />
  <Console />
  <Work />
  <Cases />
  <Experience />
  <Recommendations />
  <Writing />
  <Background />
  <Consult />
  <Footer />
</Base>
